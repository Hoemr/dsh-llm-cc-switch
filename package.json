{
  "name": "dsh-llm-cc-switch",
  "version": "0.1.0",
  "description": "DSH LLM adapter plugin: exposes every CC Switch account as a model under its harness category (Claude Code / Codex / OpenCode ...), re-reading the CC Switch database on every operation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./source": "./lib/source.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
