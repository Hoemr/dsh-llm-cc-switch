{
  "name": "dsh-llm-cc-switch",
  "version": "0.2.1",
  "description": "DSH LLM adapter plugin: exposes every CC Switch account as a model under its harness category (Claude Code / Codex / OpenCode / Grok Build …), re-reading the CC Switch database on every operation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./source": "./lib/source.js",
    "./source/internal": "./lib/source/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --no-warnings --experimental-sqlite scripts/run-integration.mjs",
    "test:all": "npm run test && npm run test:integration"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.2-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": {
    "name": "Wei Chen",
    "email": "weichen.work@qq.com",
    "url": "https://hoemr.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoemr/dsh-llm-cc-switch.git"
  },
  "bugs": {
    "url": "https://github.com/Hoemr/dsh-llm-cc-switch/issues",
    "email": "weichen.work@qq.com"
  },
  "homepage": "https://github.com/Hoemr/dsh-llm-cc-switch#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "llm",
    "cc-switch",
    "claude",
    "codex",
    "opencode",
    "grokbuild"
  ],
  "license": "MIT"
}
